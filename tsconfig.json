{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src", "scripts/make-trex.ts", "test", "playwright.config.ts", "vite.config.ts", "vitest.config.ts"]
}
