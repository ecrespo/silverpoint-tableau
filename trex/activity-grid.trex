<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="to.seraph.silverpoint.activity-grid" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>One cell per day, a column per week.</description>
    <author name="Ernesto Crespo" email="ecrespo@gmail.com" organization="silverpoint" website="https://github.com/ecrespo/silverpoint-tableau"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://ecrespo.github.io/silverpoint-tableau/v0.1/index.html?chart=activity-grid</url>
    </source-location>
    <icon/>
    <encoding id="date">
      <display-name>Date</display-name>
      <data-spec>
        <data-type>temporal</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-dimension</role-type>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Date: one field</tooltip>
    </encoding>
    <encoding id="count">
      <display-name>Count</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Count: one field (optional)</tooltip>
    </encoding>
    <encoding id="level">
      <display-name>Level</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Level: one field (optional)</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Silverpoint Activity grid</text>
    </resource>
  </resources>
</manifest>
